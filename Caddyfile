{
	# Only issue a certificate for domains the app says are active.
	on_demand_tls {
		ask http://app:3000/caddy/ask
	}
	# Port 80 belongs to the mock in docker compose.
	http_port 8080
}

https:// {
	# "internal" because Let's Encrypt can't reach *.localhost.
	# In production, remove "internal" to use Let's Encrypt/ZeroSSL.
	tls internal {
		on_demand
	}
	reverse_proxy app:3000
}
