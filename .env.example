# Hostnames that serve the dashboard (comma-separated, no port).
APP_HOSTS=localhost
# Customers can't claim this domain or its subdomains.
APP_DOMAIN=snip.example

# SaaS Custom Domains. Remove SCD_API_URL to use the real API.
SCD_API_URL=http://localhost:4010
SCD_API_TOKEN=scd_test_token
SCD_ACCOUNT_UUID=acc_local
SCD_UPSTREAM_UUID=upstream_local
# The upstream's auth token, sent in X-SaaS-Domains-Auth-Token.
PROXY_AUTH_TOKEN=local_proxy_token
# The token on your webhook in the dashboard.
SCD_WEBHOOK_TOKEN=local_webhook_token

PORT=3000
DATA_DIR=data
